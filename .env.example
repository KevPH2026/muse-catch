# ============================================
# Muse Catch v1（多用户云端版）环境变量
# ============================================
# 本地开发：复制为 .env 按需填写。
# 云端部署（Railway/Zeabur 等）：在服务设置里配置同名变量。

# ---------- 必填（生产） ----------

# 会话签名密钥。必须固定，否则每次重启所有登录态失效。
# 生成：python3 -c "import secrets; print(secrets.token_hex(32))"
MUSE_SECRET_KEY=

# 首次启动自动创建 owner 账号（也是旧数据导入脚本的目标账号）
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Mr.K

# ---------- 可选（部署） ----------

# SQLite 路径。容器里指向持久卷（Dockerfile 已默认 /data/muse.db）
# MUSE_DB_PATH=/data/muse.db

# HTTPS 部署时设 1（Cookie 加 Secure 标记）
MUSE_COOKIE_SECURE=1

# CORS 允许的源（逗号分隔，支持子域后缀匹配；chrome-extension:// 始终放行）
MUSE_ALLOWED_ORIGINS=muse.opclab.org

# 注册邀请码。留空 = 开放注册；设置后注册需携带此码（发布会控场用）
MUSE_INVITE_CODE=

# ---------- LLM（平台级，可选） ----------
# 平台付费 Key 作为无 Key 用户的回退，受每用户每日配额限制（见下）。
# 用户自己的 Key（Settings 里配置）不限量。
# 1. TokenRouter（推荐）→ https://tokenrouter.com
TR_BASE_URL=https://api.tokenrouter.com/v1
TR_API_KEY=
# 2. 或任意 OpenAI 兼容平台默认模型（二选一即可）
# DEEPSEEK_API_KEY=
# MUSE_LLM_BASE_URL=https://api.deepseek.com
# MUSE_LLM_MODEL=deepseek-chat
# 3. 每用户每日平台 LLM 调用上限（0 = 不限）；BYOK 用户不受限
MUSE_LLM_DAILY_LIMIT=50
# 4. 本地 Ollama（隐私优先，数据不出机器）
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b

# ---------- Telegram Bot（可选，第二服务） ----------
# 同一个值要配到 web 和 bot 两个服务：既是 Bot Token，也是两者间的共享密钥。
# @BotFather → /newbot 获取
MUSE_BOT_TOKEN=
# bot 服务指向 web 服务的地址
# MUSE_API_URL=https://muse.opclab.org

# ---------- 其他 ----------

# 开关：是否预置 demo 账号数据（demo@muse.local，随机密码）
MUSE_SEED_DEMO=0
# 开关：/api/dna/scan 扫描本地 ~/.openclaw 会话（仅本地模式开启）
MUSE_ENABLE_LOCAL_SCAN=0
